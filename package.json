{
  "name": "ttEditor-LC-refactored",
  "displayName": "ttEditor-LC",
  "description": "Refactored ttEditor-LC VSCode Extension - GUI for LowCode",
  "version": "1.0.0",
  "publisher": "dein-name",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscExtension.showWebview",
        "title": "Open ttEditor-LC Panel",
        "icon": "$(window)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ttEditor-LC-sidebar",
          "title": "ttEditor-LC",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "ttEditor-LC-sidebar": [
        {
          "type": "webview",
          "id": "vscExtension.view",
          "name": "ttEditor-LC"
        }
      ]
    }
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc && cd src/ui && npm run build && cd ../..",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@types/react": "^18.2.0",
    "@types/vscode": "^1.96.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.7.3",
    "zod": "^3.22.0"
  },
  "keywords": [
    "vscode-extension",
    "ttEditor-LC"
  ],
  "author": "",
  "license": "ISC"
}
