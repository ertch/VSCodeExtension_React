{
  "name": "tteditor-lowcode",
  "displayName": "ttEditor-LC",
  "description": "Lightweight Low-Code Editor für ttEditor Astro-Projekte",
  "version": "1.0.0",
  "publisher": "Erik Tchorz",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ttEditor",
          "title": "TT-Editor",
          "icon": "$(layout)"
        }
      ]
    },
    "views": {
      "ttEditor": [
        {
          "type": "webview",
          "id": "ttEditor.view",
          "name": "Projekte"
        }
      ]
    },
    "commands": [
      {
        "command": "ttEditor.openCanvas",
        "title": "Canvas öffnen",
        "category": "TT-Editor"
      },
      {
        "command": "ttEditor.saveConfig",
        "title": "Konfiguration speichern",
        "category": "TT-Editor"
      }
    ]
  },
  "scripts": {
    "compile": "tsc && node esbuild.js",
    "watch": "tsc --watch",
    "build": "npm run compile && cd src/ui && npm run build && cd ../.."
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
